<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>mssql-readonly-mcp</AssemblyName>
    <RootNamespace>MssqlReadOnlyMcp</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Microsoft.Data.SqlClient refuses to open a connection in globalization-invariant mode
         (Directory.Build.props turns it on for the libraries). -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
    <!-- Version pin of a transitive dependency of Microsoft.Data.SqlClient 7.1.1, which brings 9.0.18
         (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7; first patched 9.0.21 / 10.0.13). Not a new dependency. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MssqlReadOnlyMcp.Gate\MssqlReadOnlyMcp.Gate.csproj" />
    <ProjectReference Include="..\MssqlReadOnlyMcp.Audit\MssqlReadOnlyMcp.Audit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MssqlReadOnlyMcp.IntegrationTests" />
  </ItemGroup>

</Project>
